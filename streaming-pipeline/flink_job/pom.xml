<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.streaming</groupId>
    <artifactId>web-events-flink</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>
    <name>Web Events Flink Job</name>
    <description>Flink streaming job that aggregates web events from Kafka</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- The flink:1.18.1-scala_2.12-java11 image runs Java 11. -->
        <maven.compiler.release>11</maven.compiler.release>
        <flink.version>1.18.1</flink.version>
        <!-- The new unified Kafka connector (KafkaSource / KafkaSink) is versioned
             <connector-version>-<flink-version>. The legacy
             flink-connector-kafka_2.12:1.18.1 artifact does NOT contain
             org.apache.flink.connector.kafka.source/sink and will not compile. -->
        <kafka.connector.version>3.2.0-1.18</kafka.connector.version>
        <jackson.version>2.15.3</jackson.version>
    </properties>

    <dependencies>
        <!-- Flink core: supplied by the Flink distribution, never bundled. -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-streaming-java</artifactId>
            <version>${flink.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-clients</artifactId>
            <version>${flink.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Kafka connector: must be BUNDLED in the job jar. The Flink image only
             ships flink-connector-kafka in /opt/flink/opt, and docker-compose
             mounts the job into /opt/flink/usrlib, so the connector is not on the
             classpath unless we shade it in. Pulls in kafka-clients transitively. -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-kafka</artifactId>
            <version>${kafka.connector.version}</version>
        </dependency>

        <!-- Used directly by JsonParserFunction and MetricsSerializationSchema.
             Flink shades its own copy, so we bundle ours explicitly. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
    </dependencies>

    <build>
        <!-- Matches the jar name referenced by the README and mkdocs. -->
        <finalName>web-events-flink-1.0</finalName>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.streaming.flink.WebEventsFlinkJob</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
